<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.enrichmeai</groupId>
        <artifactId>enrich-test-api</artifactId>
        <version>0.3.0-alpha1-SNAPSHOT</version>
    </parent>
    <artifactId>test-core</artifactId>
    <name>enrich test core</name>
    <description>enrich test core</description>

    <!-- Versions come from the parent's imported BOMs (ADR 0005). -->
    <dependencies>
        <!-- JUnit 5 API needed by main sources (CloudExtension, WithCloud) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Test engine for running tests in this module -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit Platform launcher, test scope only: lets a test run a fixture class to
             completion so assertions can be made after the extension's afterAll. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Coverage floor. These are the ratios this module ACTUALLY achieves today,
              measured by `mvn -B clean verify` on 2026-09-06:
                  LINE   104/178 = 0.58   BRANCH 14/46 = 0.30
              They are a ratchet against regression, NOT the project target. The target
              remains LINE 0.80 / BRANCH 0.70, which this module does not currently meet.
              Raise these numbers as tests are added; never lower them.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.58</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.30</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
