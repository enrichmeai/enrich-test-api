<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.enrichmeai</groupId>
        <artifactId>enrich-test-api</artifactId>
        <version>0.3.0-alpha1-private.1</version>
    </parent>
    <artifactId>test-feature</artifactId>
    <name>enrich test feature</name>
    <description>enrich test feature</description>

    <!-- Versions come from the parent's imported BOMs (ADR 0005). -->
    <dependencies>
        <dependency>
            <groupId>com.enrichmeai</groupId>
            <artifactId>test-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bring AWS adapter on test classpath so ServiceLoader finds it during Cucumber runs -->
        <dependency>
            <groupId>com.enrichmeai</groupId>
            <artifactId>test-cloud-aws</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Avoid duplicate classes: test-core is already a direct dependency of this module -->
                <exclusion>
                    <groupId>com.enrichmeai</groupId>
                    <artifactId>test-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Cucumber + JUnit Platform engine for test execution -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Engine that actually executes @Suite classes. Without it CucumberQueueSuite
             is discovered but runs zero tests, so the .feature files never execute. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.skyscreamer</groupId>
            <artifactId>jsonassert</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Used by the NoSqlTable Cucumber glue to parse inline JSON payloads -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
