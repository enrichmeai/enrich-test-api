<?xml version="1.0" encoding="UTF-8"?>
<!--
  Epic 8, Story 8.3: a Spring Boot application configured, in its test, entirely from
  CloudAdapter.connectionProperties() (ADR 0011). Standalone: it is not a module of the
  enrich-test-api reactor, so Spring never reaches the library's build. The `examples`
  workflow builds it against the reactor's current version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>uploads</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>uploads (enrich-test-api Spring Boot example)</name>

    <properties>
        <java.version>17</java.version>
        <!-- The workflow passes the reactor's version; outside it, use a released one. -->
        <enrich-test-api.version>0.3.0-alpha1</enrich-test-api.version>
        <aws.sdk.v2.version>2.25.64</aws.sdk.v2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.v2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- The application's own choice of client; the test never names it. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.enrichmeai</groupId>
            <artifactId>test-core</artifactId>
            <version>${enrich-test-api.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Found through ServiceLoader; the test imports nothing from it. -->
        <dependency>
            <groupId>com.enrichmeai</groupId>
            <artifactId>test-cloud-aws</artifactId>
            <version>${enrich-test-api.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
